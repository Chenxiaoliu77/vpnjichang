{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Chenxiaoliu77/vpnjichang/blob/main/data/links.schema.json",
  "title": "vpnjichang 收录清单",
  "type": "object",
  "required": [
    "version",
    "updatedAt",
    "links"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "maintainer": {
      "type": "string"
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "categoryLabel",
          "url",
          "urlKind",
          "purpose",
          "description",
          "tags",
          "pricing",
          "platforms",
          "protocols",
          "backupUrls",
          "contact",
          "verified"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "nameZh": {
            "type": "string"
          },
          "punycodeDomain": {
            "type": [
              "string",
              "null"
            ]
          },
          "unicodeDomain": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "provider",
              "affiliate",
              "mirror",
              "tool",
              "tutorial"
            ]
          },
          "categoryLabel": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "urlKind": {
            "type": "string",
            "enum": [
              "hash-deep-link",
              "path-referral",
              "path-page",
              "plain"
            ]
          },
          "referralCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "cover": {
            "type": [
              "string",
              "null"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 4
          },
          "description": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pricing": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "plan",
                "price"
              ],
              "additionalProperties": false,
              "properties": {
                "plan": {
                  "type": "string"
                },
                "price": {
                  "type": "string"
                }
              }
            }
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "protocols": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "backupUrls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contact": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verified": {
            "type": "object",
            "required": [
              "checkedAt",
              "httpStatus",
              "method",
              "note"
            ],
            "additionalProperties": false,
            "properties": {
              "checkedAt": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "httpStatus": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              },
              "finalUrl": {
                "type": "string"
              },
              "method": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          },
          "probe": {
            "description": "由 scripts/check-links.mjs --update 写入的巡检结果。缺省表示尚未巡检。",
            "type": "object",
            "required": [
              "checkedAt",
              "health",
              "httpStatus",
              "finalUrl",
              "finalHost",
              "hostChanged",
              "detail",
              "backups"
            ],
            "additionalProperties": false,
            "properties": {
              "checkedAt": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "health": {
                "type": "string",
                "enum": [
                  "ok",
                  "cloudflare",
                  "redirected",
                  "blocked",
                  "server-error",
                  "notfound",
                  "timeout",
                  "unreachable"
                ]
              },
              "httpStatus": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 100,
                "maximum": 599
              },
              "finalUrl": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "finalHost": {
                "type": "string"
              },
              "hostChanged": {
                "type": "boolean"
              },
              "detail": {
                "type": "string"
              },
              "backups": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "url",
                    "health",
                    "httpStatus",
                    "finalUrl",
                    "hostChanged"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "url": {
                      "type": "string"
                    },
                    "health": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "cloudflare",
                        "redirected",
                        "blocked",
                        "server-error",
                        "notfound",
                        "timeout",
                        "unreachable"
                      ]
                    },
                    "httpStatus": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 100,
                      "maximum": 599
                    },
                    "finalUrl": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "hostChanged": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
